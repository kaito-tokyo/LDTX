Checks: >
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  darwin-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -portability-avoid-pragma-once

WarningsAsErrors: ''
HeaderFilterRegex: '(^|/)(Sources/LDTXAudioEngine|Tests/LDTXAudioEngineCMakeTests|Packages/LDTXAudioKit/Sources/LDTXAudioKitCore)/.*'
FormatStyle: file
