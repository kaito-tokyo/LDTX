<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>ldtxworkspace</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>LDTX Workspace</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>$(LDTX_DOCUMENT_HANDLER_RANK)</string>
			<key>LSTypeIsPackage</key>
			<true/>
			<key>LSItemContentTypes</key>
			<array>
				<string>tokyo.kaito.ldtx.workspace</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>ldtxrecord</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>LDTX Recording</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>$(LDTX_DOCUMENT_HANDLER_RANK)</string>
			<key>LSTypeIsPackage</key>
			<true/>
			<key>LSItemContentTypes</key>
			<array>
				<string>tokyo.kaito.ldtx.recording</string>
			</array>
		</dict>
		</array>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleURLName</key>
				<string>$(PRODUCT_BUNDLE_IDENTIFIER).oauth</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>$(LDTX_YOUTUBE_OAUTH_CALLBACK_URL_SCHEME)</string>
				</array>
			</dict>
		</array>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.video</string>
	<key>LDTXYouTubeOAuthCallbackURLScheme</key>
	<string>$(LDTX_YOUTUBE_OAUTH_CALLBACK_URL_SCHEME)</string>
	<key>LDTXYouTubeOutputServiceProcessXPCServiceName</key>
	<string>$(LDTX_YOUTUBE_OUTPUT_SERVICE_PROCESS_XPC_SERVICE_NAME)</string>
	<key>LDTXMCPServers</key>
	<array>
		<dict>
			<key>name</key>
			<string>$(LDTX_MCP_SERVER_NAME)</string>
			<key>transport</key>
			<string>stdio</string>
			<key>executable</key>
			<string>Contents/Library/Helpers/$(LDTX_MCP_SERVER_EXECUTABLE)</string>
			<key>arguments</key>
			<array>
				<string>mcp</string>
			</array>
		</dict>
	</array>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026</string>
	<key>NSCameraUsageDescription</key>
	<string>LDTX uses camera input as a video source for streaming and local recording.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>LDTX uses audio input for the selected Program audio track when streaming and local recording.</string>
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.tokyo.kaito.ldtx.LDTX</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>LDTX</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeDescription</key>
			<string>LDTX Workspace</string>
			<key>UTTypeIdentifier</key>
			<string>tokyo.kaito.ldtx.workspace</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ldtxworkspace</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeDescription</key>
			<string>LDTX Recording</string>
			<key>UTTypeIdentifier</key>
			<string>tokyo.kaito.ldtx.recording</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ldtxrecord</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
