If:
  PathMatch: ^Packages/LDTXAudioKit/Sources/LDTXAudioKitCore/.*$
CompileFlags:
  Add:
    - -IPackages/LDTXAudioKit/Sources/LDTXAudioKitCore/include
    - -IPackages/LDTXAudioKit/Sources/LDTXAudioKitCore/Receiver
    - -IPackages/LDTXAudioKit/Sources/LDTXAudioKitCore/Compatibility
    - -IPackages/LDTXAudioKit/Sources/LDTXAudioKitCore/Compositor
    - -IPackages/LDTXAudioKit/Sources/LDTXAudioKitCore/ms-gsl/include

---

If:
  PathMatch: ^Packages/LDTXAudioKit/Sources/LDTXAudioKitCore/.*\.(cc|cpp|cxx|hh|hpp|hxx)$
CompileFlags:
  Add:
    - -std=c++20

---

If:
  PathMatch: ^Packages/LDTXAudioKit/Sources/LDTXAudioKitCore/.*\.h$
CompileFlags:
  Remove:
    - -std=c++20
