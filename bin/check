#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Kaito Udagawa <umireon@kaito.tokyo>
#
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

printf '%s\n' 'Usage: bin/check'
printf '%s\n' '       bin/check --fix  Format C/C++ and Swift files in place'

mode=check
case "${1-}" in
  '') ;;
  --fix)
    if (($# != 1)); then
      printf '%s\n' 'error: --fix does not accept additional arguments' >&2
      exit 2
    fi
    mode=fix
    ;;
  *)
    printf 'error: unknown option: %s\n' "$1" >&2
    exit 2
    ;;
esac

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_root"

require_command() {
  local command_name="$1"
  local install_hint="$2"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    printf 'error: %s is not installed (%s)\n' "$command_name" "$install_hint" >&2
    exit 1
  fi
}

printf '%s\n' '==> Checking C/C++ formatting'
require_command clang-format 'install clang-format, for example with Homebrew'
clang-format --version

clang_format_list="$(mktemp)"
trap 'rm -f "$clang_format_list"' EXIT
if ! git ls-files -z '*.c' '*.cpp' '*.h' '*.hpp' \
  ':!Vendors/stb/stb_truetype.h' >"$clang_format_list"; then
  printf '%s\n' 'error: failed to enumerate C/C++ files with git ls-files' >&2
  exit 1
fi

clang_format_files=()
while IFS= read -r -d '' source_file; do
  clang_format_files+=("$source_file")
done <"$clang_format_list"

if ((${#clang_format_files[@]})); then
  if [[ "$mode" == fix ]]; then
    clang-format -i "${clang_format_files[@]}"
  else
    clang-format --dry-run --Werror "${clang_format_files[@]}"
  fi
fi

printf '%s\n' '==> Checking Swift formatting'
require_command swift 'install Xcode or the Swift toolchain'
swift format --version
if [[ "$mode" == fix ]]; then
  swift format format --in-place --recursive .
else
  swift format lint --strict --recursive .
fi

printf '%s\n' '==> Checking REUSE compliance'
require_command reuse 'install with pipx install reuse'
reuse --no-multiprocessing lint

printf '%s\n' '==> Checking standalone ldtx CLI'
require_command swift 'install Xcode or the Swift toolchain'
swift package resolve
swift test --filter LDTXUtilsTests

printf '%s\n' 'Check CI passed.'
